# /etc/systemd/system/riftbound-scanner.service
#
# Install on the Pi:
#   sudo cp riftbound-scanner.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable riftbound-scanner   ← starts on every boot
#   sudo systemctl start riftbound-scanner    ← start right now
#
# Check status / logs:
#   sudo systemctl status riftbound-scanner
#   journalctl -u riftbound-scanner -f

[Unit]
Description=Riftbound NFC Card Scanner
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/card-scanner
# Activate the Python virtual environment, then launch the server.
ExecStart=/home/pi/card-scanner/.venv/bin/uvicorn src.server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
# If the NFC reader isn't ready on the first try, the service will
# restart automatically after 5 seconds until it succeeds.

[Install]
WantedBy=multi-user.target
