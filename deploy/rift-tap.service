# /etc/systemd/system/rift-tap.service
#
# Installed automatically by deploy/setup.sh.
# Manual install:
#   sudo cp rift-tap.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable rift-tap
#
# Logs:  journalctl -u rift-tap -f

[Unit]
Description=Rift Tap NFC Card Scanner
# Start after the USB gadget network interface is up so the server
# binds to the correct address from the first boot.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/rift-tap
EnvironmentFile=/home/pi/rift-tap/.env
ExecStart=/home/pi/rift-tap/.venv/bin/uvicorn src.server:app --host 0.0.0.0 --port 8000
# Restart on any failure - handles the NFC HAT not being ready at first boot
# and recovers cleanly from any unexpected crash.
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
